# Copy to .env and fill in. Read only by the local server; never sent to the browser.
# Get a free key at https://www.themoviedb.org/settings/api (v3 API key or v4 read access token).
TMDB_KEY=

# Optional: port for `npm run dev` / `npm run start` (default 8443).
# PORT=8443

# Optional: keep the database somewhere other than ./data (must be outside the project folder).
# CINETRACK_DATA_DIR=/absolute/path/to/folder
